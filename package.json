{
  "name": "rankbot",
  "version": "2.0.0",
  "description": "Discord bot that surfaces braacket.com power-ranking data and assigns roles by percentile.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "BOT_ENV=dev tsx watch src/index.ts",
    "register": "tsx src/discord/register.ts",
    "register:dev": "BOT_ENV=dev tsx src/discord/register.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "heroku-postbuild": "npm run build"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "braacket",
    "firestore"
  ],
  "author": "Drew Dearing",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.10.0",
    "typesaurus": "^10.7.0",
    "undici": "^7.29.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
