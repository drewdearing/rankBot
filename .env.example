# ── Production (required) ────────────────────────────────────────────────────
# Discord bot token (Developer Portal -> Bot -> Token)
BOT_TOKEN=

# Discord application (client) ID — required to register slash commands
DISCORD_CLIENT_ID=

# Firebase service account, as a single-line JSON string
# (Project Settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"rankbot-1ada2","private_key":"..."}

# ── Production (optional) ────────────────────────────────────────────────────
# Proxy for braacket.com requests only (never Discord or Firebase). Cloudflare
# blocks braacket for Heroku's datacenter IPs, so production can't scrape
# without one; dev ignores it (BOT_ENV=dev). A full URL with credentials,
# `http://user:pass@host:port`. A literal {session} in it is replaced on every
# attempt to get a fresh exit IP; for IPRoyal, the session, country and
# lifetime parameters go in the password part. `deploy.sh --env` syncs it to
# Heroku when it is present here. Leave the line commented out unless it has a
# value: an empty value fails config validation (and would be synced as empty).
# BRAACKET_PROXY_URL=

# ── Local development (optional) ─────────────────────────────────────────────
# Use a SEPARATE Discord bot for local dev so it doesn't fight the deployed bot's
# gateway connection (same token = same identity = conflict). `npm run dev` and
# `npm run register:dev` set BOT_ENV=dev, which uses these instead of the prod
# token/client id. Leave blank in production. (Firestore is still shared unless
# you also point FIREBASE_SERVICE_ACCOUNT at a separate dev project.)
DEV_BOT_TOKEN=
DEV_CLIENT_ID=

# In dev mode, register slash commands to this guild only (instant). Production
# always registers globally.
DEV_GUILD_ID=
